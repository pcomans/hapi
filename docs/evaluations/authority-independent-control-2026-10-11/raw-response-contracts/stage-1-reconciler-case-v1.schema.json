{
 "$id": "hapi-authority-control-raw-response/stage-1-reconciler-case/1",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "artifact_exceptions": {
   "items": {
    "minLength": 1,
    "type": "string"
   },
   "type": "array"
  },
  "case_id": {
   "minLength": 1,
   "type": "string"
  },
  "evidence_sha256": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "resolutions": {
   "additionalProperties": false,
   "minProperties": 1,
   "properties": {
    "same_entity": {
     "additionalProperties": false,
     "properties": {
      "citations": {
       "items": {
        "pattern": "^https?://",
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "outcome": {
       "enum": [
        "same_entity",
        "different_entity",
        "insufficient_evidence"
       ]
      },
      "rationale": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "outcome",
      "rationale",
      "citations"
     ],
     "type": "object"
    },
    "useful_granularity": {
     "additionalProperties": false,
     "properties": {
      "citations": {
       "items": {
        "pattern": "^https?://",
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "outcome": {
       "enum": [
        "useful",
        "too_broad",
        "too_narrow",
        "insufficient_evidence"
       ]
      },
      "rationale": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "outcome",
      "rationale",
      "citations"
     ],
     "type": "object"
    }
   },
   "type": "object"
  }
 },
 "required": [
  "case_id",
  "evidence_sha256",
  "resolutions",
  "artifact_exceptions"
 ],
 "title": "Stage 1 reconciler raw response for one case",
 "type": "object",
 "x-hapi-role": "stage_1_reconciler"
}
