{
 "$id": "hapi-authority-control-raw-response/stage-1-reviewer-case/2",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "else": {
  "properties": {
   "citations": {
    "minItems": 1
   }
  }
 },
 "if": {
  "properties": {
   "same_entity": {
    "const": "insufficient_evidence"
   },
   "useful_granularity": {
    "const": "insufficient_evidence"
   }
  },
  "required": [
   "same_entity",
   "useful_granularity"
  ]
 },
 "properties": {
  "case_id": {
   "minLength": 1,
   "type": "string"
  },
  "citations": {
   "items": {
    "pattern": "^https?://",
    "type": "string"
   },
   "type": "array"
  },
  "evidence_sha256": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "reasoning": {
   "minLength": 1,
   "type": "string"
  },
  "same_entity": {
   "enum": [
    "same_entity",
    "different_entity",
    "insufficient_evidence"
   ]
  },
  "useful_granularity": {
   "enum": [
    "useful",
    "too_broad",
    "too_narrow",
    "insufficient_evidence"
   ]
  }
 },
 "required": [
  "case_id",
  "evidence_sha256",
  "same_entity",
  "useful_granularity",
  "reasoning",
  "citations"
 ],
 "title": "Stage 1 reviewer raw response for one case",
 "type": "object",
 "x-hapi-role": "stage_1_reviewer"
}
