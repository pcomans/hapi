{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-review-artifact-1.json",
  "title": "Structured independent evidence review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "decision_key", "decision_kind", "subject", "reviewer", "outcome", "method", "citations", "reasoning", "llm_interaction"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-review-artifact/1"},
    "review_id": {"type": "string", "minLength": 1},
    "decision_key": {"type": "string", "minLength": 1},
    "decision_kind": {"enum": ["link_support", "strict_refinement_support", "equivalence_support"]},
    "subject": {"type": "object", "minProperties": 2},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_id", "independence_group"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "independence_group": {"type": "string", "minLength": 1}
      }
    },
    "outcome": {"enum": ["supported", "unsupported", "uncertain"]},
    "method": {"enum": ["human", "llm"]},
    "citations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_kind", "locator", "evidence_summary", "originating_museum"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_kind": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "evidence_summary": {"type": "string", "minLength": 1},
          "originating_museum": {"const": false}
        }
      }
    },
    "reasoning": {"type": "string", "minLength": 1},
    "llm_interaction": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["model_selector", "backend_model_id_or_non_exposure_sentinel", "parameters", "prompt", "input", "raw_response", "prompt_leakage_audit"],
          "properties": {
            "model_selector": {"type": "string", "minLength": 1},
            "backend_model_id_or_non_exposure_sentinel": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"},
            "prompt": {"$ref": "#/$defs/artifact"},
            "input": {"$ref": "#/$defs/artifact"},
            "raw_response": {"$ref": "#/$defs/artifact"},
            "prompt_leakage_audit": {
              "type": "object", "additionalProperties": false,
              "required": ["passed", "opaque_shuffled_candidate_ids", "artifact"],
              "properties": {
                "passed": {"const": true},
                "opaque_shuffled_candidate_ids": {"const": true},
                "artifact": {"$ref": "#/$defs/artifact"}
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "git_blob_oid"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    }
  }
}
