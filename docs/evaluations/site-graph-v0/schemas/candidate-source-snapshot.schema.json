{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-candidate-source-snapshot-1.json",
  "title": "Frozen candidate authority source snapshot",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source_snapshot_id", "authority_name", "source_kind", "acquired_at_utc", "provenance", "completeness", "records"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-candidate-source-snapshot/1"},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "authority_name": {"type": "string", "minLength": 1},
    "source_kind": {"type": "string", "minLength": 1},
    "acquired_at_utc": {"type": "string", "format": "date-time"},
    "provenance": {"type": "object", "minProperties": 1},
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_statement", "known_incompleteness", "complete_for_candidate_target_derivation"],
      "properties": {
        "coverage_statement": {"type": "string", "minLength": 1},
        "known_incompleteness": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "complete_for_candidate_target_derivation": {"const": true}
      }
    },
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_record_id", "target_id", "source_types", "parent_ids", "child_ids", "authority_citations"],
        "properties": {
          "source_record_id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "parent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "child_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authority_citations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
