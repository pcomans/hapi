{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-candidate-hierarchy-4.json",
  "title": "Candidate hierarchy derived from every frozen source record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coverage", "known_incompleteness", "nodes"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-candidate-hierarchy/4"},
    "coverage": {"const": "every_target_and_every_record_from_all_authenticated_complete_authority_source_exports"},
    "known_incompleteness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed_world_claim", "limitations", "derivation_statement"],
      "properties": {
        "closed_world_claim": {"const": false},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "derivation_statement": {"type": "string", "minLength": 1}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "candidate_e55_type", "child_ids", "ancestor_target_ids", "source_export_ids", "source_record_ids"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "candidate_e55_type": {"type": "string", "minLength": 1},
          "child_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "ancestor_target_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_export_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
