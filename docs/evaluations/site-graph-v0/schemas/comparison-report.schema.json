{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-comparison-report-2.json",
  "title": "Deterministic authenticated site-graph-v0 comparison report",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "outcome", "ordered_decision_trace", "integrity", "safety_gates", "event_counts", "event_records", "reassignment_edge_modes", "per_museum", "pairs", "ambiguity_and_abstention"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-comparison-report/2"},
    "outcome": {"enum": ["INVALID", "REDESIGN", "CONTINUE", "STOP"]},
    "ordered_decision_trace": {"type": "array", "minItems": 1},
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["passed", "errors"],
      "properties": {
        "passed": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "safety_gates": {"type": "object"},
    "event_counts": {"type": "object"},
    "event_records": {"type": "array"},
    "reassignment_edge_modes": {"type": "object"},
    "per_museum": {"type": "object"},
    "pairs": {"type": "object"},
    "ambiguity_and_abstention": {"type": "object"}
  }
}
