{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-authority-source-export-1.json",
  "title": "Complete authenticated authority source export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_export_id", "authority_name", "source_kind", "originating_museum", "acquired_at_utc", "provenance", "completeness", "records"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-authority-source-export/1"},
    "source_export_id": {"type": "string", "minLength": 1},
    "authority_name": {"type": "string", "minLength": 1},
    "source_kind": {"type": "string", "minLength": 1},
    "originating_museum": {"const": false},
    "acquired_at_utc": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_locator", "acquisition_method", "producer_identity"],
      "properties": {
        "source_locator": {"type": "string", "minLength": 1},
        "acquisition_method": {"type": "string", "minLength": 1},
        "producer_identity": {"type": "string", "minLength": 1}
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_statement", "known_incompleteness", "record_selection_policy", "record_count", "records_canonical_sha256", "complete_for_candidate_target_derivation"],
      "properties": {
        "coverage_statement": {"type": "string", "minLength": 1},
        "known_incompleteness": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "record_selection_policy": {"const": "all_records_in_authenticated_source_export"},
        "record_count": {"type": "integer", "minimum": 1},
        "records_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "complete_for_candidate_target_derivation": {"const": true}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_record_id", "target_id", "authority_identity_locator", "raw_source_types", "parent_ids", "child_ids", "authority_citations"],
        "properties": {
          "source_record_id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "authority_identity_locator": {"type": "string", "minLength": 1},
          "raw_source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "parent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "child_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authority_citations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
