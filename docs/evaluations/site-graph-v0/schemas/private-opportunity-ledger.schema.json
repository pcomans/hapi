{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-private-opportunity-ledger-2.json",
  "title": "Private exact intent-to-treat membership ledger",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "privacy", "selection_algorithm", "selected_signature_count", "opportunities", "intent_to_treat_records_by_museum", "credited_pair_opportunity_memberships"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-private-opportunity-ledger/2"},
    "privacy": {"type": "string", "minLength": 1},
    "selection_algorithm": {"type": "object", "minProperties": 1},
    "selected_signature_count": {"type": "integer", "minimum": 1},
    "opportunities": {"type": "array", "minItems": 1},
    "intent_to_treat_records_by_museum": {
      "type": "object", "additionalProperties": false,
      "required": ["met", "brooklyn", "harvard"],
      "properties": {
        "met": {"$ref": "#/$defs/ittRecords"},
        "brooklyn": {"$ref": "#/$defs/ittRecords"},
        "harvard": {"$ref": "#/$defs/ittRecords"}
      }
    },
    "credited_pair_opportunity_memberships": {
      "type": "object", "additionalProperties": false,
      "required": ["met__brooklyn", "met__harvard", "brooklyn__harvard"],
      "properties": {
        "met__brooklyn": {"$ref": "#/$defs/pair"},
        "met__harvard": {"$ref": "#/$defs/pair"},
        "brooklyn__harvard": {"$ref": "#/$defs/pair"}
      }
    }
  },
  "$defs": {
    "ittRecords": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "opportunity_ids", "baseline_record_scope"]}},
    "pair": {"type": "object", "required": ["sides"], "properties": {"sides": {"type": "object"}}}
  }
}
