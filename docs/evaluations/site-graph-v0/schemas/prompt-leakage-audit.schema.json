{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-prompt-leakage-audit-3.json",
  "title": "Authenticated pre-invocation prompt leakage audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "review_id", "review_invocation_id", "decision_key", "decision_kind", "subject", "prompt", "input", "audit_method", "auditor", "executed_at_utc", "deterministic_guard", "authentication"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-prompt-leakage-audit/3"},
    "audit_id": {"type": "string", "pattern": "^[^\\s]+$"},
    "review_id": {"type": "string", "pattern": "^[^\\s]+$"},
    "review_invocation_id": {"type": "string", "pattern": "^[^\\s]+$"},
    "decision_key": {"type": "string", "minLength": 1},
    "decision_kind": {"enum": ["link_support", "strict_refinement_support", "equivalence_support", "distinctness_support"]},
    "subject": {"type": "object", "minProperties": 2},
    "prompt": {"$ref": "#/$defs/artifact"},
    "input": {"$ref": "#/$defs/artifact"},
    "audit_method": {"const": "deterministic_prompt_leakage_guard/1"},
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditor_id", "independence_group"],
      "properties": {
        "auditor_id": {"type": "string", "pattern": "^[^\\s]+$"},
        "independence_group": {"type": "string", "pattern": "^[^\\s]+$"}
      }
    },
    "executed_at_utc": {"type": "string", "format": "date-time"},
    "deterministic_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guard_version", "request_binding_sha256", "candidate_ids", "source_ids", "answer_strings", "result", "findings"],
      "properties": {
        "guard_version": {"const": "site-graph-v0-deterministic-prompt-leakage-guard/1"},
        "request_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_ids": {"$ref": "#/$defs/forbidden_set_binding"},
        "source_ids": {"$ref": "#/$defs/forbidden_set_binding"},
        "answer_strings": {"$ref": "#/$defs/forbidden_set_binding"},
        "result": {"const": "PASS"},
        "findings": {"type": "array", "maxItems": 0}
      }
    },
    "authentication": {"$ref": "#/$defs/authentication"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "git_blob_oid"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "forbidden_set_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "canonical_sha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "signature_context", "principal_id", "key_id", "signed_at_utc", "statement_sha256", "signature"],
      "properties": {
        "registry_id": {"type": "string", "pattern": "^[^\\s]+$"},
        "signature_context": {"const": "hapi-site-graph-v0-review-evidence/1"},
        "principal_id": {"type": "string", "pattern": "^[^\\s]+$"},
        "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signed_at_utc": {"type": "string", "format": "date-time"},
        "statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
