{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-prompt-leakage-audit-2.json",
  "title": "Pre-generation prompt leakage audit bound to one exact review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "review_id", "review_invocation_id", "decision_key", "decision_kind", "subject", "prompt", "passed", "opaque_shuffled_candidate_ids", "audit_method", "auditor_id", "executed_at_utc", "findings"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-prompt-leakage-audit/2"},
    "audit_id": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "review_invocation_id": {"type": "string", "minLength": 1},
    "decision_key": {"type": "string", "minLength": 1},
    "decision_kind": {"enum": ["link_support", "strict_refinement_support", "equivalence_support", "distinctness_support"]},
    "subject": {"type": "object", "minProperties": 2},
    "prompt": {"$ref": "#/$defs/artifact"},
    "passed": {"const": true},
    "opaque_shuffled_candidate_ids": {"const": true},
    "audit_method": {"type": "string", "minLength": 1},
    "auditor_id": {"type": "string", "minLength": 1},
    "executed_at_utc": {"type": "string", "format": "date-time"},
    "findings": {"type": "array"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "git_blob_oid"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    }
  }
}
