{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-relation-ledger-2.json",
  "title": "Frozen, positively reviewed candidate relation census",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strict_refinement_direction", "identity_census_policy", "relations"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-relation-ledger/2"},
    "strict_refinement_direction": {"const": "left_target_id_is_narrower_than_right_target_id"},
    "identity_census_policy": {"const": "every_counted_distinct_class_pair_has_positive_distinctness_or_source_locator_equivalence"},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_id", "left_target_id", "right_target_id", "relation", "review_decision_key"],
        "properties": {
          "relation_id": {"type": "string", "minLength": 1},
          "left_target_id": {"type": "string", "minLength": 1},
          "right_target_id": {"type": "string", "minLength": 1},
          "relation": {"enum": ["strict_refinement", "equivalent", "distinct"]},
          "review_decision_key": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
