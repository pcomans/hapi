{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hapi.example/schemas/site-graph-v0-candidate-freeze-manifest-2.json",
  "title": "Authenticated pre-run candidate input freeze",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "candidate_id", "run_nonce", "release_manifest_sha256", "private_opportunity_ledger_canonical_sha256", "trusted_run_attestors", "created_at_utc", "created_by", "provenance", "files"],
  "properties": {
    "schema_version": {"const": "site-graph-v0-candidate-freeze-manifest/2"},
    "contract_version": {"const": "site-graph-v0/3"},
    "candidate_id": {"type": "string", "minLength": 1},
    "run_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "private_opportunity_ledger_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trusted_run_attestors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "raw_sha256", "git_blob_oid", "canonical_sha256", "status", "attestor_key_ids"],
      "properties": {
        "path": {"const": "docs/evaluations/site-graph-v0/trusted-run-attestors.json"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "CONFIGURED"},
        "attestor_key_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "minProperties": 1},
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256", "git_blob_oid", "media_type", "schema_version"],
        "properties": {
          "role": {"enum": ["hierarchy", "source_snapshot", "relation_ledger", "review_prompt", "prompt_leakage_audit"]},
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
          "media_type": {"enum": ["application/json", "text/plain"]},
          "schema_version": {"type": ["string", "null"]}
        }
      }
    }
  }
}
